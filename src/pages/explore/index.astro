---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { subjects } from '../../data/subjects';
const all = await getCollection('articles');
const articles = all.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
const categoryCounts = Object.fromEntries(subjects.map(s=>[s, articles.filter(a=>a.data.category === s).length]));
const route = (a) => `/${a.data.section}/${a.id}/`;
---
<Base title="Explore — The Psychology Library" description="Psychology learning articles and research perspectives, arranged by subject and linked to sources.">
  <main id="main">
    <section class="explore-hero">
      <div class="site-wrap hero-inner">
        <div class="hero-copy">
          <span class="mini-rule">MIND ASSEMBLY / EXPLORE</span>
          <h1>Read the theory.<br /><em>Examine the evidence.</em></h1>
          <p>Clinical psychology, cognition, neuroscience, development and research methods—collected in one evolving reading room.</p>
          <a class="hero-anchor" href="#catalog">Browse the library <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-disc"></div><div class="art-seal">Ψ</div>
          <div class="art-paper art-card-one"><span class="art-small">MIND ASSEMBLY / FIELD NOTES</span><span class="art-word">Learn<br />what lasts.</span><span class="art-small">THE PSYCHOLOGY LIBRARY</span></div>
          <div class="art-paper art-card-two"><span class="art-small">EVIDENCE / INTERPRETATION</span><span class="art-word">Think<br />beyond the<br />headline.</span><span class="art-small">RESEARCH & PERSPECTIVES</span></div>
          <div class="art-caption">READ / COMPARE / QUESTION / RETURN</div>
        </div>
      </div>
    </section>
    <div class="collection-strip"><div class="site-wrap strip-inner">
      <a class="collection-mode" href="#catalog" data-mode-jump="library"><div><span class="mini-rule">THE FIRST COLLECTION</span><h2 class="mode-head">Psychology Library</h2><div class="mode-desc">Concepts, frameworks and methods explained carefully, with a route to the original source.</div></div><span class="mode-arrow">↗</span></a>
      <a class="collection-mode" href="#catalog" data-mode-jump="research"><div><span class="mini-rule">THE SECOND COLLECTION</span><h2 class="mode-head">Research & Perspectives</h2><div class="mode-desc">Closer readings of evidence, emerging constructs, and the limits of research claims.</div></div><span class="mode-arrow">↗</span></a>
    </div></div>
    <section id="catalog" class="collection-area" aria-labelledby="catalog-heading"><div class="site-wrap">
      <div class="section-top"><div><span class="mini-rule">EXPLORE / INDEX</span><h2 id="catalog-heading">The reading catalogue.</h2></div><p>Begin with a subject, a collection or a question. Follow a <a href="/learning/">learning pathway</a> for a guided sequence.</p></div>
      <div class="catalog-shell"><aside class="catalog-sidebar" aria-label="Filter by subject">
        <h3>Subjects</h3><div class="filter-list"><button class="filter-button" type="button" data-subject-filter="All subjects" aria-pressed="true"><span>All subjects</span><span class="filter-count">{articles.length}</span></button>
          {subjects.map(subject=><button type="button" class="filter-button" data-subject-filter={subject} aria-pressed="false"><span>{subject}</span><span class="filter-count">{categoryCounts[subject]}</span></button>)}
        </div><p class="sidebar-note">Each reading includes sources and its editorial status.</p>
      </aside><div class="catalog-main">
        <div class="catalog-toolbar"><label class="catalog-search"><span class="search-icon" aria-hidden="true">⌕</span><span class="screenreader">Search titles, topics and descriptions</span><input id="catalog-query" type="search" autocomplete="off" placeholder="Search a topic, theory or question..."/></label><button type="button" class="search-clear" id="catalog-clear" hidden>Clear</button>
          <div class="collection-tabs" aria-label="Filter by collection"><button type="button" class="collection-tab" data-section-filter="all" aria-pressed="true">All readings</button><button type="button" class="collection-tab" data-section-filter="library" aria-pressed="false">Psychology Library</button><button type="button" class="collection-tab" data-section-filter="research" aria-pressed="false">Research & Perspectives</button></div></div>
        <div class="result-summary"><span id="result-count" role="status">{articles.length} readings shown</span></div>
        <div class="cards" id="article-cards">
          {articles.map(article=><article class="article-card" data-article-card data-category={article.data.category} data-section={article.data.section} data-search={`${article.data.title} ${article.data.excerpt} ${article.data.category} ${article.data.level}`}>
            <div><div class="card-accent"></div><div class="card-inside"><div class="card-meta"><span>{article.data.category}</span><span>{article.data.section==='library'?'Library':'Research'}</span></div><h3><a href={route(article)}>{article.data.title}</a></h3><p>{article.data.excerpt}</p></div></div>
            <div class="card-bottom"><a href={route(article)} aria-label={`Read ${article.data.title}`}>Open reading ↗</a><span>{article.data.minutes} min</span></div>
          </article>)}
        </div><div class="no-results" id="catalog-empty" hidden>No readings match this filter. Try a different term or subject.</div>
      </div></div>
    </div></section>
  </main>
 <script src="/scripts/explore-filter.js" defer></script>
</Base>
