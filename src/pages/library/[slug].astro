---
import { getCollection } from 'astro:content';
import Reading from '../../components/Reading.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', article => article.data.section === 'library');
  return articles.map(article => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
---
<Reading article={article} />
